# Copy this to Makefile.local (gitignored, per-machine) to work around a
# local toolchain problem without changing the Makefile everyone shares.
# It is included first, so anything set here wins over the Makefile's `?=`
# defaults — including the SDK pin.
#
# The macOS 27 SDK is already pinned away in the Makefile itself (see the
# SwiftUIMacros comment there); this file is for the next one. Diagnose with:
#   swift --version                                    # "Target: arm64-apple-macosx<N>.0"
#   ls -la /Library/Developer/CommandLineTools/SDKs/    # MacOSX.sdk -> MacOSX<M>.sdk
# If M > N, pin SDKROOT to the matching (non-beta) SDK. The older `native`
# build engine is the other escape hatch when `swiftbuild` misbehaves.
#
# export SDKROOT := $(shell xcrun --sdk macosx26.5 --show-sdk-path)
# SWIFT_BUILD_FLAGS := --build-system native
